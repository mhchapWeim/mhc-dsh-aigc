POSTGRES_DB=aigc_hub
POSTGRES_USER=aigc_hub
POSTGRES_PASSWORD=replace-with-a-long-random-password

JWT_KEY=replace-with-a-random-secret-at-least-32-characters
CALLBACK_SECRET=replace-with-a-random-callback-secret

AIGC_LITELLM_BASE_URL=http://host.docker.internal:4000/v1
AIGC_LITELLM_PUBLIC_BASE_URL=http://172.28.12.33:4000/v1
