{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "aigc-edge",
    "namespace": "bosch-aigc-dsh"
  },
  "spec": {
    "replicas": 1,
    "strategy": {
      "type": "Recreate"
    },
    "selector": {
      "matchLabels": {
        "app": "aigc-edge"
      }
    },
    "template": {
      "metadata": {
        "labels": {
          "app": "aigc-edge"
        }
      },
      "spec": {
        "nodeSelector": {
          "kubernetes.io/hostname": "bosch-k8s-node-nj304"
        },
        "hostNetwork": true,
        "dnsPolicy": "ClusterFirstWithHostNet",
        "containers": [
          {
            "name": "nginx",
            "image": "aigc-edge-nginx:2026-09-28.2",
            "imagePullPolicy": "Never",
            "ports": [
              {
                "name": "http",
                "containerPort": 80
              },
              {
                "name": "https",
                "containerPort": 443
              }
            ],
            "volumeMounts": [
              {
                "name": "config",
                "mountPath": "/etc/nginx/conf.d/default.conf",
                "subPath": "default.conf",
                "readOnly": true
              },
              {
                "name": "tls",
                "mountPath": "/etc/nginx/tls",
                "readOnly": true
              },
              {
                "name": "desktop-updates",
                "mountPath": "/srv/desktop-updates",
                "readOnly": true
              }
            ],
            "readinessProbe": {
              "tcpSocket": {
                "port": "https"
              },
              "periodSeconds": 10
            },
            "resources": {
              "requests": {
                "cpu": "50m",
                "memory": "64Mi"
              },
              "limits": {
                "memory": "256Mi"
              }
            }
          }
        ],
        "volumes": [
          {
            "name": "config",
            "configMap": {
              "name": "aigc-edge-nginx"
            }
          },
          {
            "name": "tls",
            "secret": {
              "secretName": "aigc-edge-tls"
            }
          },
          {
            "name": "desktop-updates",
            "hostPath": {
              "path": "/data/bosch-aigc-dsh/desktop-updates",
              "type": "DirectoryOrCreate"
            }
          }
        ]
      }
    }
  }
}