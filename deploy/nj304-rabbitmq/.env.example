# Set an internal nj304 IP reachable by the AIGC API and the receiving services before deployment.
MQ_BIND_ADDRESS=127.0.0.1
MQ_PORT=5672
MQ_MANAGEMENT_PORT=15672
RABBITMQ_IMAGE=rabbitmq:4.2-management
# Supply different strong secrets to prepare.py through environment variables (not this example).
# MQ_ADMIN_PASSWORD / MQ_PRODUCER_PASSWORD / MQ_CONSUMER_PASSWORD
