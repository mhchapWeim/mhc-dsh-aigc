{
  "name": "@bhss/dsh-plugin-managed-search",
  "version": "1.0.0",
  "description": "组织托管网页搜索，由 AIGC 控制授权并通过博查提供搜索来源",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": { ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" } },
  "files": ["lib", "cordis.patch.yml"],
  "scripts": { "build": "node build.mjs", "test": "node --test tests/*.test.mjs", "pack": "npm run build && npm pack" },
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-web": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-credentials": "0.1.7-alpha.2"
  },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "aigc": { "dshVersion": "0.1.7-alpha.2", "kind": "host", "capabilities": ["web-search"], "serverAdapter": "bocha" },
  "license": "MIT"
}
